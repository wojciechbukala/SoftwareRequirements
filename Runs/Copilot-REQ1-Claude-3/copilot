#!/usr/bin/env python3
"""Copilot: Driver-assistance onboard computer simulator."""
import argparse
import csv
import os
from dataclasses import dataclass
from typing import List, Optional

# States
DISENGAGED = "DISENGAGED"
ENGAGED = "ENGAGED"
ALARM = "ALARM"

# Thresholds
EMERGENCY_BRAKING_DISTANCE = 5.0   # meters, strictly less than triggers braking
STEERING_FORCE_DISENGAGE = 10.0    # N, strictly greater than causes disengagement
STEERING_FORCE_VALID_MAX = 3.0     # N, at most this is a valid attentiveness response
ATTENTIVENESS_INTERVAL = 120.0     # seconds between attentiveness prompts
ATTENTIVENESS_TIMEOUT = 5.0        # seconds driver has to respond


@dataclass
class Event:
    timestamp: float
    source: str  # 'sensor' or 'driver'
    data: dict


def load_sensor_events(filepath: str) -> List[Event]:
    if not os.path.exists(filepath):
        return []
    events = []
    with open(filepath, encoding='utf-8') as f:
        for row in csv.DictReader(f):
            events.append(Event(
                timestamp=float(row['timestamp']),
                source='sensor',
                data={
                    'sensor_id': row['sensor_id'].strip(),
                    'sensor_type': row['sensor_type'].strip().lower(),
                    'data_value': float(row['data_value']),
                    'unit': row['unit'].strip(),
                }
            ))
    return events


def load_driver_events(filepath: str) -> List[Event]:
    if not os.path.exists(filepath):
        return []
    events = []
    with open(filepath, encoding='utf-8') as f:
        for row in csv.DictReader(f):
            events.append(Event(
                timestamp=float(row['timestamp']),
                source='driver',
                data={
                    'event_type': row['event_type'].strip().lower(),
                    'value': float(row['value']),
                }
            ))
    return events


class Copilot:
    def __init__(self):
        self.state = DISENGAGED
        self.target_speed: Optional[float] = None

        # Attentiveness check state
        self.next_attentiveness_time: Optional[float] = None
        self.attentiveness_pending: bool = False
        self.attentiveness_deadline: Optional[float] = None

        # Output buffers
        self.state_log: List[dict] = []
        self.commands_log: List[dict] = []
        self.feature_decisions: List[dict] = []

    # ------------------------------------------------------------------ helpers

    def _transition(self, timestamp: float, new_state: str, trigger: str):
        """Record a state transition only if the state actually changes."""
        if new_state != self.state:
            self.state_log.append({
                'timestamp': timestamp,
                'previous_state': self.state,
                'current_state': new_state,
                'trigger_event': trigger,
            })
            self.state = new_state

    def _command(self, timestamp: float, actuator_id: str, values):
        self.commands_log.append({
            'timestamp': timestamp,
            'actuator_id': actuator_id,
            'values': values,
        })

    def _decision(self, timestamp: float, feature: str, decision):
        self.feature_decisions.append({
            'timestamp': timestamp,
            'feature': feature,
            'decision': decision,
        })

    # ------------------------------------------------------------------ state changes

    def _engage(self, timestamp: float, trigger: str):
        self._transition(timestamp, ENGAGED, trigger)
        self.next_attentiveness_time = timestamp + ATTENTIVENESS_INTERVAL
        self.attentiveness_pending = False
        self.attentiveness_deadline = None

    def _disengage(self, timestamp: float, trigger: str):
        self._transition(timestamp, DISENGAGED, trigger)
        self.next_attentiveness_time = None
        self.attentiveness_pending = False
        self.attentiveness_deadline = None

    # ------------------------------------------------------------------ timer handling

    def _advance_timers(self, current_time: float):
        """Fire timer-driven events that fell between the previous event and now."""
        if self.state == DISENGAGED:
            return

        # Issue attentiveness prompt when the 120 s interval elapses (ENGAGED only).
        if (self.state == ENGAGED
                and not self.attentiveness_pending
                and self.next_attentiveness_time is not None
                and self.next_attentiveness_time <= current_time):
            prompt_ts = self.next_attentiveness_time
            self._command(prompt_ts, 'Steering Wheel', 'ATTENTIVENESS_CHECK')
            self.attentiveness_pending = True
            self.attentiveness_deadline = prompt_ts + ATTENTIVENESS_TIMEOUT

        # Transition to ALARM when the 5 s response window closes.
        if (self.attentiveness_pending
                and self.attentiveness_deadline is not None
                and self.attentiveness_deadline <= current_time
                and self.state != ALARM):
            alarm_ts = self.attentiveness_deadline
            self._transition(alarm_ts, ALARM, 'attentiveness_timeout')
            self._command(alarm_ts, 'Alarm', 'ALARM_ON')

    # ------------------------------------------------------------------ sensor processing

    def _handle_lidar(self, timestamp: float, data_value: float):
        """Emergency braking (always) + cruise control (engaged/alarm)."""
        # Emergency braking — always active regardless of mode.
        if data_value < EMERGENCY_BRAKING_DISTANCE:
            self._decision(timestamp, 'emergency braking', 'BRAKE')
            self._command(timestamp, 'Braking System', 'BRAKE')
        else:
            self._decision(timestamp, 'emergency braking', 'NO BRAKE')

        # Cruise control — only while engaged (including alarm sub-state).
        if self.state in (ENGAGED, ALARM):
            if self.target_speed is not None:
                # Proportional distance-based throttle adjustment.
                safe_gap = max(self.target_speed * 2.0, 20.0)
                throttle = round((data_value - safe_gap) * 0.05, 4)
            else:
                throttle = round(data_value * 0.01, 4)
            self._decision(timestamp, 'cruise control', throttle)
            self._command(timestamp, 'Throttle', throttle)

    def _handle_camera(self, timestamp: float, data_value: float):
        """Lane keeping — only while engaged (including alarm sub-state)."""
        if self.state in (ENGAGED, ALARM):
            correction = round(data_value, 4)
            self._decision(timestamp, 'lane keeping', correction)
            self._command(timestamp, 'Steering Wheel', correction)

    def process_sensor_event(self, event: Event):
        ts = event.timestamp
        self._advance_timers(ts)
        sensor_type = event.data['sensor_type']
        data_value = event.data['data_value']
        if sensor_type == 'lidar':
            self._handle_lidar(ts, data_value)
        elif sensor_type == 'camera':
            self._handle_camera(ts, data_value)

    # ------------------------------------------------------------------ driver event processing

    def _handle_steering_force(self, timestamp: float, force: float):
        """Respond to a steering-wheel force event for attentiveness checks."""
        if not self.attentiveness_pending or self.state not in (ENGAGED, ALARM):
            return

        if self.state == ALARM:
            # In ALARM, any valid response clears the alarm immediately.
            if force <= STEERING_FORCE_VALID_MAX:
                self.attentiveness_pending = False
                self.attentiveness_deadline = None
                self._transition(timestamp, ENGAGED, 'steering_wheel_force')
                self._command(timestamp, 'Alarm', 'ALARM_OFF')
                self.next_attentiveness_time = timestamp + ATTENTIVENESS_INTERVAL
            # 3 < force < 10: ignored
            return

        # ENGAGED state — check within the 5 s window.
        if (self.attentiveness_deadline is not None
                and timestamp > self.attentiveness_deadline):
            return  # response arrived after deadline; alarm already fired via _advance_timers

        if force <= STEERING_FORCE_VALID_MAX:
            self.attentiveness_pending = False
            self.attentiveness_deadline = None
            self.next_attentiveness_time = timestamp + ATTENTIVENESS_INTERVAL
        # 3 < force < 10: ignored; keep waiting

    def process_driver_event(self, event: Event):
        ts = event.timestamp
        self._advance_timers(ts)

        event_type = event.data['event_type']
        value = event.data['value']

        # Steering force > 10 N causes immediate disengagement at any time.
        if event_type == 'steering_wheel_force' and value > STEERING_FORCE_DISENGAGE:
            if self.state != DISENGAGED:
                self._disengage(ts, 'steering_wheel_force')
            return

        if event_type == 'engage':
            if self.state == DISENGAGED:
                self._engage(ts, 'engage')

        elif event_type == 'disengage':
            if self.state != DISENGAGED:
                self._disengage(ts, 'disengage')

        elif event_type == 'set_speed':
            self.target_speed = value

        elif event_type == 'steering_wheel_force':
            self._handle_steering_force(ts, value)

    # ------------------------------------------------------------------ main loop

    def process_events(self, events: List[Event]):
        for event in sorted(events, key=lambda e: e.timestamp):
            if event.source == 'sensor':
                self.process_sensor_event(event)
            else:
                self.process_driver_event(event)

    # ------------------------------------------------------------------ output

    def write_outputs(self, output_dir: str):
        os.makedirs(output_dir, exist_ok=True)

        with open(os.path.join(output_dir, 'state_log.csv'), 'w', encoding='utf-8', newline='') as f:
            w = csv.DictWriter(f, fieldnames=['timestamp', 'previous_state', 'current_state', 'trigger_event'])
            w.writeheader()
            w.writerows(self.state_log)

        with open(os.path.join(output_dir, 'commands_log.csv'), 'w', encoding='utf-8', newline='') as f:
            w = csv.DictWriter(f, fieldnames=['timestamp', 'actuator_id', 'values'])
            w.writeheader()
            w.writerows(self.commands_log)

        with open(os.path.join(output_dir, 'feature_decision.csv'), 'w', encoding='utf-8', newline='') as f:
            w = csv.DictWriter(f, fieldnames=['timestamp', 'feature', 'decision'])
            w.writeheader()
            w.writerows(self.feature_decisions)


# ---------------------------------------------------------------------------- entry point

def main():
    parser = argparse.ArgumentParser(description='Copilot driver-assistance system simulator')
    parser.add_argument('--input', required=True, help='Directory containing sensor_log.csv and driver_events.csv')
    parser.add_argument('--output', required=True, help='Directory to write output CSV files')
    args = parser.parse_args()

    sensor_events = load_sensor_events(os.path.join(args.input, 'sensor_log.csv'))
    driver_events = load_driver_events(os.path.join(args.input, 'driver_events.csv'))

    copilot = Copilot()
    copilot.process_events(sensor_events + driver_events)
    copilot.write_outputs(args.output)


if __name__ == '__main__':
    main()
